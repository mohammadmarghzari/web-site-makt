# ─────────────────────────────────────────────────────────────
# MAKT — نمونهٔ متغیرهای محیطی
#
# سایت یک خروجی کاملاً ثابت است و روی GitHub Pages منتشر می‌شود،
# پس این مقادیر «زمان بیلد» خوانده می‌شوند نه زمان اجرا.
#
# برای سایت منتشرشده، این‌ها را به‌جای فایل .env در گیت‌هاب وارد کنید:
#   Settings → Secrets and variables → Actions → New repository secret
#
# ⚠️ هیچ‌کدام الزامی نیست. بدون همهٔ این‌ها سایت با دادهٔ نمونه کار می‌کند.
# ─────────────────────────────────────────────────────────────

# ── دیتابیس، پنل مدیریت، ثبت سفارش و آپلود فایل ──────────────
# از داشبورد Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ کلید service_role اینجا وجود ندارد و نباید اضافه شود.
# در یک سایت ثابت هر مقداری سر از باندل مرورگر درمی‌آورد، پس هیچ
# جای امنی برایش نیست. کل معماری طوری نوشته شده که به آن نیازی
# نداشته باشد: نوشتن‌ها را RLS کنترل می‌کند و ثبت سفارش از تابع
# place_order در خود دیتابیس رد می‌شود.

# ── آدرس سایت ────────────────────────────────────────────────
# برای sitemap و متادیتای اشتراک‌گذاری. در GitHub Actions خودکار
# ساخته می‌شود؛ فقط برای دامنهٔ اختصاصی دستی تنظیمش کنید.
# NEXT_PUBLIC_SITE_URL=https://makt.ir

# ── زیرشاخهٔ انتشار ──────────────────────────────────────────
# GitHub Pages سایت را زیر نام مخزن سرو می‌کند. در Actions خودکار
# تنظیم می‌شود. برای دامنهٔ اختصاصی خالی بگذارید.
# PAGES_BASE_PATH=
