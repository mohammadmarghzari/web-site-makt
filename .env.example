# ─────────────────────────────────────────────────────────────
# MAKT — نمونهٔ متغیرهای محیطی
#
# این فایل فقط الگوست و هیچ مقدار واقعی‌ای نباید داخلش نوشته شود.
# مقادیر واقعی را در پنل Vercel وارد کنید:
#   Vercel → پروژه → Settings → Environment Variables
#
# در فاز ۱ و ۲ (وضعیت فعلی) هیچ‌کدام از این‌ها لازم نیست؛
# سایت با دادهٔ نمونه کار می‌کند.
# ─────────────────────────────────────────────────────────────

# ── فاز ۳ — Supabase ─────────────────────────────────────────
# از داشبورد Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# فقط سمت سرور. هرگز با پیشوند NEXT_PUBLIC_ استفاده نشود،
# چون آن پیشوند مقدار را داخل باندل مرورگر می‌فرستد.
SUPABASE_SERVICE_ROLE_KEY=

# ── فاز ۶ — زرین‌پال ─────────────────────────────────────────
# تا وقتی Merchant ID واقعی ندارید روی true بماند.
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=

# آدرس عمومی سایت — برای ساخت لینک بازگشت از درگاه لازم است.
# مثال: https://makt.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
