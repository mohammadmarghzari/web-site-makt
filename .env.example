# ─────────────────────────────────────────────────────────────
# MAKT — نمونهٔ متغیرهای محیطی
#
# این فایل فقط الگوست و هیچ مقدار واقعی‌ای نباید داخلش نوشته شود.
# مقادیر واقعی را در پنل Vercel وارد کنید:
#   Vercel → پروژه → Settings → Environment Variables
#
# ⚠️ هیچ‌کدام از این‌ها برای بالا‌آمدن سایت الزامی نیست.
# بدون همهٔ این‌ها سایت با دادهٔ نمونه و پرداخت آزمایشی کار می‌کند.
# ─────────────────────────────────────────────────────────────

# ── دیتابیس، پنل مدیریت و آپلود فایل ─────────────────────────
# از داشبورد Supabase → Project Settings → API
# بدون این دو، سایت روی دادهٔ نمونه می‌ماند و پنل مدیریت غیرفعال است.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# فقط سمت سرور. هرگز با پیشوند NEXT_PUBLIC_ استفاده نشود،
# چون آن پیشوند مقدار را داخل باندل مرورگر می‌فرستد.
# این کلید RLS را کاملاً دور می‌زند.
# بدون آن، سفارش‌ها ذخیرهٔ دائمی نمی‌شوند.
SUPABASE_SERVICE_ROLE_KEY=

# ── درگاه پرداخت ─────────────────────────────────────────────
# تا وقتی روی true بماند، از درگاه آزمایشی داخلی استفاده می‌شود:
# سفارش ثبت می‌شود ولی هیچ پولی جابه‌جا نمی‌شود.
ZARINPAL_SANDBOX=true

# فقط سمت سرور. با گذاشتن این و false کردن بالایی، پرداخت واقعی می‌شود.
ZARINPAL_MERCHANT_ID=

# ── آدرس سایت ────────────────────────────────────────────────
# برای ساخت لینک بازگشت از درگاه و آدرس‌های sitemap لازم است.
# بعد از اتصال دامنه، حتماً روی دامنهٔ نهایی تنظیمش کنید.
# مثال: https://makt.ir
NEXT_PUBLIC_SITE_URL=http://localhost:3000
